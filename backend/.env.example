APP_NAME=Work Invigilator API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000
WORKERS=4

JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/workinvigilator
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

BACKBLAZE_KEY_ID=your-backblaze-key-id
BACKBLAZE_APPLICATION_KEY=your-backblaze-application-key
BACKBLAZE_BUCKET_NAME=workinvigilator-media
BACKBLAZE_BUCKET_ID=your-bucket-id
BACKBLAZE_REGION=us-west-002

MAX_SCREENSHOT_SIZE_MB=5
MAX_AUDIO_SIZE_MB=50

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

SENTRY_DSN=
LOG_LEVEL=INFO

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
